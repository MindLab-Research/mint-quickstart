# MinT API Key (required)
MINT_API_KEY=sk-mint-your-api-key-here

# Server endpoint (optional — defaults to https://mint.macaron.xin/)
# If the default endpoint is slow, try:
#   Mainland China: https://mint-cn.macaron.xin/
#   Outside Mainland China: https://mint.macaron.xin/
# MINT_BASE_URL=https://mint.macaron.xin/

# Base model (optional)
# MINT_BASE_MODEL=Qwen/Qwen3-0.6B

# LoRA rank (optional)
# MINT_LORA_RANK=16

# HuggingFace mirror (optional — use if you have network issues)
# HF_ENDPOINT=https://hf-mirror.com

# Tinker SDK compatibility (optional — use instead of MINT_* vars)
# Same endpoint alternatives apply here if the default is slow.
# TINKER_BASE_URL=https://mint.macaron.xin/
# TINKER_API_KEY=sk-mint-your-api-key-here
